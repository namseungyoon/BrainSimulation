# 05 Micro-slice 로컬 보강 규칙 (대용량 규칙은 저장소 루트 .gitignore 에 있음)
# 주석은 반드시 줄 맨 앞 — git .gitignore 는 인라인 주석 미지원
data/
scratch/
__pycache__/
*.py[cod]
_*.log
_*.err
_*.pid
# figures 하위 중간 데이터·로그 (PNG 만 추적)
*/*/figures/_*.npz
*/*/figures/_*.npy
*/*/figures/*.log
*/*/figures/.last_rc
# 생성 HTML(세포 데이터 임베드, make_picker.py 로 재생성)
**/window_picker.html
