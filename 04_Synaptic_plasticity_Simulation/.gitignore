# 04 트랙 로컬 gitignore. 루트 .gitignore 규칙을 상속받고 여기에 보강한다.
# ⚠️ git 은 인라인 주석을 지원하지 않는다. 주석은 반드시 줄 맨 앞에.

# 일회성 작업 공간 (설치본 다운로드 등)
scratch/

# 04 전용 파이썬 가상환경 (docs/ENVIRONMENT.md 1-2)
.venv/

# 진단기의 현재상태 산출. 1-1_env_probe.json(동결 기준선)은 반대로 추적한다.
*/*/figures/_env_probe_latest.json

# 메커니즘 빌드 산출물 — manifest 로 모아 빌드하는 staging 과 컴파일 결과
mechanisms/_build/
# 입력 mod 해시. 변경 없으면 재빌드를 건너뛰기 위한 로컬 캐시일 뿐이다.
mechanisms/_build.stamp
mechanisms/*.dll
mechanisms/*.c
mechanisms/*.o
mechanisms/x86_64/
mechanisms/arm64/

# 중간 데이터 — 밑줄로 시작하는 것만 제외한다. 결과 PNG 는 추적한다.
# 밑줄 없는 산출물(예: 1-1_env_probe.json)은 결과물이므로 추적한다.
*/*/figures/_*.npz
*/*/figures/_*.npy
*/*/figures/_*.json
*/*/figures/_*.csv

# 로그
*.log
*.err
*.pid

# 파이썬
__pycache__/
*.py[cod]

# 논문 원문 PDF (저작권 · 대용량) — 로컬 참조용
99_references/
