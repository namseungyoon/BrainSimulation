+
+__device__ __forceinline__ uint userM6SourceHash( uint source )
+{
+  source ^= source >> 16;
+  source *= 0x7feb352dU;
+  source ^= source >> 15;
+  source *= 0x846ca68bU;
+  return source ^ ( source >> 16 );
+}
+
+__device__ __forceinline__ uint64_t splitMix64( uint64_t value )
+{
+  uint64_t z = value + 0x9E3779B97F4A7C15ULL;
+  z = ( z ^ ( z >> 30 ) ) * 0xBF58476D1CE4E5B9ULL;
+  z = ( z ^ ( z >> 27 ) ) * 0x94D049BB133111EBULL;
+  return z ^ ( z >> 31 );
+}
+
+__device__ __forceinline__ int userM7Lane( int port, uint64_t u )
+{
+  int n_site = ( port == 0 ? 24 : ( port == 10 ? 18 : 18 ) );
+  int site = ( int ) __umul64hi( u, ( uint64_t ) n_site );
+  if ( port == 0 ) return site < 12 ? 0 : 1;             // Pyr, apical >100
+  if ( port == 10 ) return site < 9 ? 0 : 1;             // O-LM, apical >200
+  if ( site < 4 ) return 0;                              // 50--200 table
+  if ( site < 8 ) return 1;
+  if ( site < 13 ) return 2;
+  return 3;
+}
+
+__device__ __forceinline__ int userM7Contacts( int port )
+{
+  if ( port == 0 ) return 3;
+  if ( port == 3 ) return 2;
+  if ( port == 10 || port == 12 || port == 17 ) return 10;
+  return 1;
+}
+
+__device__ __forceinline__ void addBranchInput(
+  inode_t source, inode_t target, int port, double* slot, double value )
+{
+  int group = NodeGroupMap[ target ];
+  int64_t offset = slot - input_spike_buffer_1d_;
+  if ( NodeGroupArray[ group ].node_type_ == i_user_m6_model &&
+       NodeGroupArray[ group ].branch_count_arr_ != nullptr )
+  {
+    int relative = target - NodeGroupArray[ group ].i_node_0_;
+    int count = max( 1, min( 4, ( int ) roundf(
+      NodeGroupArray[ group ].branch_count_arr_[
+        relative * NodeGroupArray[ group ].branch_count_arr_step_ ] ) ) );
+    int branch = ( int ) ( userM6SourceHash( source ) % ( uint ) count );
+    atomicAdd( &user_m6_input_spike_buffer_[ branch * input_spike_buffer_size_ + offset ], value );
+    return;
+  }
+  if ( NodeGroupArray[ group ].node_type_ != i_user_m7_model ) return;
+  const uint64_t rotated_target = ( ( uint64_t ) target << 21 ) | ( ( uint64_t ) target >> 43 );
+  const uint64_t base = 0x50564D4F52504831ULL ^ ( uint64_t ) source
+    ^ rotated_target ^ ( ( uint64_t ) ( port + 1 ) * 0xD6E8FEB86659FD93ULL );
+  if ( port == 13 ) // compressed CCK/SCA ambiguity: declared coherent-anchor fallback
+  {
+    int branch = userM7Lane( port, splitMix64( base ) );
+    atomicAdd( &user_m6_input_spike_buffer_[ branch * input_spike_buffer_size_ + offset ], value );
+    return;
+  }
+  const int contacts = userM7Contacts( port );
+  for ( int j = 0; j < contacts; ++j )
+  {
+    uint64_t u = splitMix64( base ^ ( ( uint64_t ) j * 0x9E3779B97F4A7C15ULL ) );
+    int branch = userM7Lane( port, u );
+    atomicAdd( &user_m6_input_spike_buffer_[ branch * input_spike_buffer_size_ + offset ],
+      value / contacts );
+  }
+}
 
